#!/usr/bin/env node

/**
 * Module dependencies.
 */
require("dotenv").config();
var app = require("../app");
var debug = require("debug")("middleware-sincond:server");
var http = require("http");

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || "3001");
app.set("port", port);
console.log(port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Disable default timeouts for long-running relay control requests.
 *
 * Node.js 18 defaults:
 *   server.requestTimeout  = 300000 ms (5 min) — kills idle incoming requests
 *   server.timeout         = 0       (none)   — kills active sockets
 *
 * The /api/relay/wake endpoint holds connections open for up to 10 minutes
 * while waiting for LoRaWAN Class A meter uplinks. Without this, concurrent
 * bulk relay requests (10 meters × 300s) trigger "fetch failed" errors.
 */
server.requestTimeout = 0;
server.timeout = 0;
server.keepAliveTimeout = 0;

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on("error", onError);
server.on("listening", onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== "listen") {
    throw error;
  }

  var bind = typeof port === "string" ? "Pipe " + port : "Port " + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case "EACCES":
      console.error(bind + " requires elevated privileges");
      process.exit(1);
      break;
    case "EADDRINUSE":
      console.error(bind + " is already in use");
      process.exit(1);
      break;
    default:
      throw error;
  }
}

const { SvcMessages } = require("../services/V2/serviceMessagesSub");
const { SvcSubscribeRunFirst } = require("../services/V2/serviceSubscribe");
setTimeout(() => {
  console.log("start loging");
  SvcMessages();
}, 120000);
setTimeout(() => {
  console.log("start subcribe");
  SvcSubscribeRunFirst()
    .then((r) => console.log("[subscribe] ok:", r))
    .catch((err) => console.log("[subscribe] error (non-fatal):", err));
}, 2000);
/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === "string" ? "pipe " + addr : "port " + addr.port;
  debug("Listening on " + bind);
}
